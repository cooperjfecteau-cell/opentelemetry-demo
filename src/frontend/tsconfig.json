{
  "compilerOptions": {
    "target": "ES2015",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // The two settings Dynatrace Live Debugger's docs name for TypeScript. They are
    // inert here - noEmit is on and Next transpiles with SWC, which already emits the
    // server map with sourcesContent embedded - but they keep tsc-based tooling in
    // agreement and are what would apply if this project ever emitted through tsc.
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "protos/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
